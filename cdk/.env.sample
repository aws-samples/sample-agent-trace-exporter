dry_run = "true"
filter_span_attributes = "aws.xray.origin=AWS::BedrockAgentCore::*"
log_group_name = "aws/spans"

# Using Finch as container runtime for CDK bundling instead of Docker
# CDK_DOCKER = "finch"

# =============================================================================
# Multi-endpoint OTLP configuration (JSON array)
# Each entry: {"endpoint": "<url>", "headers": "key=val,key2=val2"}
# When set, this takes precedence over otlp_endpoint/otlp_headers below.
# =============================================================================
otlp_endpoints = '[{"endpoint": "https://your-otel-collector:4318", "headers": "Authorization=Bearer token123"},{"endpoint": "https://collector-2:4318", "headers": "Authorization=Bearer tokenXYZ"}]'

# =============================================================================
# Single-endpoint fallback (used only if otlp_endpoints is empty/unset)
# =============================================================================
# otlp_endpoint = "https://your-otel-collector:4318"
# otlp_headers = "Authorization=Bearer token123"
